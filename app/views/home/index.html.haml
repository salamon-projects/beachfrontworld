- content_for :title, "Stays steps from what you came for"
- content_for :description, "Tell us what you want to be near. We measure the real walk from every hotel and apartment along the streets, with the busy roads on the way, and show the closest first."

%section.hero
  .container.hero__inner
    .hero__text
      %span.eyebrow Measured, not marketed
      %h1.hero__title
        Stay
        %em steps from
        what you came for.
      %p.hero__lead
        Booking sites say “0.4 km from the centre” in a straight line. We measure the walk itself — along the
        streets, past the busy roads you would have to cross — from every stay to every sight, square and beach.
    .hero__figure
      = render "home/hero_plan"
    .hero__search
      - if @destinations.empty?
        %p.hero__notice We are still measuring our first destination. Check back soon.
      - else
        = render "home/search_form"
        - if @examples.any?
          %p.hero__examples
            %span.hero__examples-label Try
            - @examples.each do |landmark|
              = link_to landmark.name, landmark_path(landmark), class: "landmark-chip"

%section.section#destinations
  .container
    %span.eyebrow Destinations
    %h2.section__title Places we have measured
    - if @destinations.empty?
      %p.empty-state We are still measuring our first destination. Check back soon.
    - @destinations.group_by(&:country_name).each do |country, destinations|
      %h3.country-title= country
      %ul.destination-grid
        - destinations.each do |destination|
          - landmarks = @landmark_counts.fetch(destination.id, 0)
          %li.destination-tile
            = link_to destination_path(destination), class: "destination-tile__link" do
              - if destination.sea_name.present?
                %span.destination-tile__sea= destination.sea_name
              %span.destination-tile__name= destination.name
              %span.destination-tile__counts
                %span.destination-tile__count
                  = pluralize(@listed_counts.fetch(destination.id, 0), "measured stay")
                - if landmarks.positive?
                  %span.destination-tile__direct= "· #{pluralize(landmarks, 'place')} to stay near"
              %span.destination-tile__arrow{ "aria-hidden": "true" } →

%section.section.section--sand
  .container
    .method
      .method__intro
        %span.eyebrow Method
        %h2.section__title How we measure
        %p.section__intro
          Every result is a measurement on the map, not a booking site’s label. No property can pay to rank higher.
        %p= link_to "Read the full method", how_we_verify_path, class: "text-link"
      %ol.steps
        %li.step
          %h3.step__title Find the place
          %p Sights, squares, pedestrian streets, parks and beaches come from OpenStreetMap, in every language they are named in.
        %li.step
          %h3.step__title Walk the streets
          %p We measure each walk along the streets, paths and steps people actually use — never in a straight line.
        %li.step
          %h3.step__title Count what’s in the way
          %p Busy roads to cross and flights of steps are counted, and everything is measured again when the map changes.
