- content_for :title, "Verified beachfront hotels and apartments"
- content_for :description, "Beachfront hotels and apartments in #{@destinations.map(&:country_name).uniq.to_sentence}, each measured against map data so you know exactly how far the water is. Compare booking sites in one place."
- content_for :head, json_ld(website_ld)

%section.hero
  .container.hero__inner
    .hero__text
      %span.eyebrow Measured, not marketed
      %h1.hero__title
        Only stays that are
        %em really
        on the water.
      %p.hero__lead
        Booking sites call almost anything “beachfront”. We measure every property’s distance to the water from
        map data, check for roads in between, and only list the ones that pass.
    .hero__figure
      = render "home/hero_plan"
    .hero__search
      - if @destinations.empty?
        %p.hero__notice We are still measuring our first coastline. Check back soon.
      - else
        -# search_form.js turns the destination select into a searchable list
        -# and the guest counts into one "2 adults · 0 children" field.
        = form_with url: search_path, method: :get, class: "search-form",
          data: { search_form: t("search.picker").merge(stays: t("search.picker_stays")).to_json } do
          .field.field--wide.field--destination
            = label_tag :destination, t("search.destination")
            = select_tag :destination,
              grouped_options_for_select(destination_options(@destinations, @listed_counts)),
              prompt: t("search.picker.where_to"), required: true
          = render "shared/stay_fields", stay: nil
          .field.field--submit
            = submit_tag t("search.submit"), name: nil, class: "button button--primary"
- content_for :scripts do
  = javascript_include_tag "search_form", defer: true

%section.section#destinations
  .container
    %span.eyebrow Destinations
    %h2.section__title Coastlines we have measured
    - if @destinations.empty?
      %p.empty-state We are still measuring our first coastline. Check back soon.
    - @destinations.group_by(&:country_name).each do |country, destinations|
      %h3.country-title
        = link_to country, country_path(Country.new(destinations.first.country_code))
      %ul.destination-grid
        - destinations.each do |destination|
          = render "destinations/tile", destination:, listed: @listed_counts.fetch(destination.id, 0),
            direct: @direct_counts.fetch(destination.id, 0)

%section.section.section--sand
  .container
    .method
      .method__intro
        %span.eyebrow Method
        %h2.section__title How we verify
        %p.section__intro
          Every listing starts as a measurement. A booking site’s “beachfront” label is only ever a hint.
        %p= link_to "Read the full method", how_we_verify_path, class: "text-link"
      %ol.steps
        %li.step
          %h3.step__title Measure
          %p We measure the distance from the building to the shoreline using OpenStreetMap data — not the booking site’s label.
        %li.step
          %h3.step__title Check what’s in between
          %p A road or railway between the property and the water rules out “beachfront”. Promenades and beach surfaces are noted too.
        %li.step
          %h3.step__title Re-measure
          %p Every property is measured again whenever the map changes, so the result stays current.
