-# A plan-view sketch of what we measure: the walk from a stay to a sight
-# along the streets, against the straight line booking sites quote.
-# Decorative; the text beside it says the same.
%svg.hero-plan{ viewBox: "0 0 480 400", "aria-hidden": "true", focusable: "false" }
  %g.hero-plan__streets
    - [ 110, 230, 340 ].each do |y|
      %path{ d: "M0 #{y}H480" }
    - [ 110, 370 ].each do |x|
      %path{ d: "M#{x} 0V400" }
  %path.hero-plan__avenue{ d: "M250 0V400" }
  %path.hero-plan__avenue-line{ d: "M250 0V400" }
  %g.hero-plan__blocks
    - [ [ 14, 14, 82, 82 ], [ 138, 14, 98, 82 ], [ 264, 14, 92, 82 ], [ 14, 124, 82, 92 ], [ 138, 124, 98, 92 ],
        [ 264, 124, 92, 92 ], [ 384, 124, 82, 92 ], [ 138, 244, 98, 82 ], [ 264, 244, 92, 82 ], [ 384, 244, 82, 82 ],
        [ 14, 354, 82, 40 ], [ 138, 354, 98, 40 ], [ 264, 354, 92, 40 ], [ 384, 354, 82, 40 ] ].each do |x, y, width, height|
      %rect{ x:, y:, width:, height: }
  %rect.hero-plan__building{ x: "34", y: "250", width: "52", height: "36" }
  %path.hero-plan__crow{ d: "M86 252L404 76" }
  %text.hero-plan__crow-label{ x: "274", y: "178" } 380 m straight
  %path.hero-plan__route{ d: "M86 268H110V230H370V110V84H404" }
  %path.hero-plan__crossing{ d: "M243 223l14 14M257 223l-14 14" }
  %circle.hero-plan__landmark{ cx: "418", cy: "70", r: "13" }
  %text.hero-plan__route-label{ x: "126", y: "220" } 7 min · 760 steps
  %text.hero-plan__note{ x: "262", y: "262" } 1 busy road
  %text.hero-plan__note{ x: "34", y: "306" } Your stay
  %text.hero-plan__note{ x: "446", y: "40", "text-anchor": "end" } The sight
  %g.hero-plan__scale
    %path{ d: "M20 382h60M20 377v10M50 379v6M80 377v10" }
    %text{ x: "88", y: "386" } 100 m
