- content_for :title, "Stays in #{@destination.name}, measured on foot"
- content_for :description, "#{@destination.name}: hotels and apartments with the walk to every sight, square and beach measured on the map. Compare booking sites for your dates."
- if params.keys.intersect?(%w[check_in check_out adults children child_ages near max_minutes kind quiet sort page])
  - content_for :noindex, true
= render "layouts/map_assets"
- content_for :scripts do
  = javascript_include_tag "filters", defer: true

%section.page-header
  .container
    %nav.breadcrumbs{ "aria-label": "Breadcrumb" }
      = link_to "Destinations", root_path(anchor: "destinations")
      %span{ "aria-hidden": "true" } ›
      %span= @destination.country_name
    %h1.page-header__title= @destination.name
    %p.page-header__lead
      = pluralize(@pagy.count, "measured stay")
      - if @search.near
        = "· #{t("search.near_kinds.#{@search.near}").downcase_first} first"
    - if @destination.summary.present?
      %p.page-header__summary= @destination.summary
    - if @top_landmarks.any?
      %nav.landmark-chips{ "aria-label": "Stay near" }
        %span.landmark-chips__label Stay near
        - @top_landmarks.each do |landmark|
          = link_to landmark.name, landmark_path(landmark, stay_params), class: "landmark-chip"

= render "shared/listing", search: @search, properties: @properties, offers: @offers, pagy: @pagy,
  map_data: @map_data, form_url: destination_path(@destination), landmarks: @landmarks
