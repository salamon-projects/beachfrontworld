- total = @listed_counts.values.sum
- direct = @direct_counts.values.sum
- content_for :title, "Beachfront hotels and apartments in #{@country.name}"
- content_for :description, "#{pluralize(total, 'verified waterfront stay')} across #{pluralize(@destinations.size, 'coastline')} in #{@country.name}: #{@destinations.map(&:name).to_sentence}. Each one measured against map data, #{direct} of them right on the beach."
- content_for :canonical, country_url(@country)
- content_for :head do
  = json_ld(breadcrumb_ld([ [ "Destinations", root_url ], [ @country.name, country_url(@country) ] ]))
  = json_ld(country_ld(@country, @destinations))

- content_for :masthead do
  .container.masthead__body
    %nav.breadcrumbs{ "aria-label": "Breadcrumb" }
      = link_to "Destinations", root_path(anchor: "destinations")
      %span{ "aria-hidden": "true" } ›
      %span= @country.name
    %h1.masthead__title
      Beachfront stays in
      %em= @country.name
    %p.masthead__lead
      Every hotel and apartment here was measured against OpenStreetMap: its distance to the water and whether a
      road runs in between. Pick a coastline to compare booking sites for your dates.
    .masthead__meta
      %span.chip
        %span.chip__dot
        = "#{pluralize(number_with_delimiter(total), 'verified waterfront stay')} on #{pluralize(@destinations.size, 'coastline')}"
      - if direct.positive?
        %span.chip= "#{number_with_delimiter(direct)} right on the beach"

%section.section
  .container
    .section__head
      %div
        %span.eyebrow Coastlines
        %h2.section__title= "Choose your coast in #{@country.name}."
    %ul.coast-grid
      - @destinations.each_with_index do |destination, index|
        = render "destinations/tile", destination:, index:, listed: @listed_counts.fetch(destination.id, 0),
          direct: @direct_counts.fetch(destination.id, 0)

- if @highlights.any?
  .section.section--sand
    .container
      .section__head
        %div
          %span.eyebrow Right on the beach
          %h2.section__title= "Closest to the water in #{@country.name}"
          %p.section__intro Measured right on the beach, nearest first.
      %ol.property-list.property-list--grid
        - @highlights.each do |property|
          %li= render "destinations/property_card", property:, offers: [], place: property.destination.name, heading: :h3
