%footer.site-footer
  .container
    .site-footer__top
      .site-footer__about
        = link_to root_path, class: "brand brand--ink" do
          = render "layouts/brand_mark"
          %span.brand__name= t("site_name")
        %p Measured, not marketed. Beachfront stays checked against the map, not the listing.
      .site-footer__columns
        %nav.site-footer__nav{ "aria-label": "Beachfront guides" }
          %span.site-footer__heading Beachfront
          - published_countries.each do |country|
            = link_to country.name, country_path(country)
        %nav.site-footer__nav{ "aria-label": "About" }
          %span.site-footer__heading About
          = link_to "How we verify & rank", how_we_verify_path
          = link_to "Affiliate disclosure", affiliate_disclosure_path
          = link_to "Privacy", privacy_path
    .site-footer__bottom
      %p.site-footer__disclosure= t("offers.disclosure")
      %p.site-footer__attribution
        Map data ©
        = succeed "," do
          = link_to "OpenStreetMap contributors", "https://www.openstreetmap.org/copyright", rel: "noopener"
        ODbL
