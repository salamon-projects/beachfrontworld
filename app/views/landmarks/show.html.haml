- destination = @landmark.destination
- content_for :title, "Stays near #{@landmark.name}, #{destination.name}: the walk measured"
- content_for :description, "Hotels and apartments near #{@landmark.name} in #{destination.name}, ordered by the walk we measured on the map: minutes, steps and busy roads on the way."
- if params.keys.intersect?(%w[check_in check_out adults children child_ages max_minutes kind quiet sort page])
  - content_for :noindex, true
= render "layouts/map_assets"
- content_for :scripts do
  = javascript_include_tag "filters", defer: true

%section.page-header
  .container
    %nav.breadcrumbs{ "aria-label": "Breadcrumb" }
      = link_to "Destinations", root_path(anchor: "destinations")
      - if destination.published?
        %span{ "aria-hidden": "true" } ›
        = link_to destination.name, destination_path(destination, stay_params)
    %span.eyebrow= t("landmarks.kinds.#{@landmark.kind}")
    %h1.page-header__title
      Stays near
      = @landmark.name
    %p.page-header__lead
      = pluralize(@pagy.count, "stay")
      = "within #{number_with_precision(Walks.max_walk_m / 1000.0, precision: 1, strip_insignificant_zeros: true)} km on foot, the shortest walk first"
    - if @landmark.local_name.present? && @landmark.local_name != @landmark.name
      %p.page-header__summary= "Locally: #{@landmark.local_name}"

= render "shared/listing", search: @search, properties: @properties, offers: @offers, pagy: @pagy,
  map_data: @map_data, form_url: landmark_path(@landmark), landmarks: @landmarks
