-# What measuring a landmark has found so far: walks measured, then stays
-# found but not measured yet, by straight-line distance.
- if walks.any? || pending.any?
  %ul.walk-list.measuring__list
    - walks.each do |walk|
      %li.walk-list__item
        %span.walk-list__place
          = link_to walk.property.name, property_path(walk.property, stay_params.merge(near: @landmark.slug))
          %small= property_kind(walk.property)
        %span.walk-list__minutes= t("walks.minutes", count: walk.minutes)
        %span.walk-list__notes
          = walk_steps(walk)
          = "· #{walk.busy_crossings.zero? ? t("walks.no_busy_roads_short") : t("walks.busy_roads_short", count: walk.busy_crossings)}"
    - pending.each do |property|
      %li.walk-list__item.walk-list__item--pending
        %span.walk-list__place
          = property.name
          %small= property_kind(property)
        %span.walk-list__minutes= "≈ #{number_with_delimiter(property.straight_m.round(-1).to_i)} m"
        %span.walk-list__notes= t(@landmark.measure_failed? ? "landmarks.measuring.straight_line_only" : "landmarks.measuring.straight_line")
