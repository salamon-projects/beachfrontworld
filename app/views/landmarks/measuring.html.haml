- destination = @landmark.destination
- content_for :title, "Stays near #{@landmark.name}: measuring the walks"
- content_for :noindex, true
- if @landmark.measuring?
  - content_for :head do
    -# Without JS the page reloads itself; measuring.js updates it in place.
    %noscript
      %meta{ "http-equiv": "refresh", content: LandmarksHelper::REFRESH_SECONDS }
  - content_for :scripts do
    = javascript_include_tag "measuring", defer: true

%section.page-header
  .container
    %nav.breadcrumbs{ "aria-label": "Breadcrumb" }
      = link_to "Destinations", root_path(anchor: "destinations")
      - if destination.published?
        %span{ "aria-hidden": "true" } ›
        = link_to destination.name, destination_path(destination, stay_params)
    %span.eyebrow= t("landmarks.kinds.#{@landmark.kind}")
    %h1.page-header__title
      Stays near
      = @landmark.name

.container
  - if @landmark.measure_failed?
    .measuring
      %p.measuring__title= t("landmarks.measuring.failed")
      = button_to t("landmarks.measuring.retry"), measure_landmark_path(@landmark, stay_params), class: "button"
      = render "landmarks/preview", walks: @walks, pending: @pending
  - else
    .measuring{ data: { measuring: LandmarksHelper::REFRESH_SECONDS } }
      %p.measuring__title{ role: "status" }
        %span.measuring__pulse{ "aria-hidden": "true" }
        = measuring_status(@landmark, @measured_count, @pending_count)
      %p.measuring__note= t("landmarks.measuring.note", km: number_with_precision(Walks.max_walk_m / 1000.0, precision: 1, strip_insignificant_zeros: true))
      = render "landmarks/preview", walks: @walks, pending: @pending
      %p.measuring__note= t("landmarks.measuring.refresh")
